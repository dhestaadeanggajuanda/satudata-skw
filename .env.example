# Salin ke .env untuk pengembangan lokal / docker-compose. Jangan commit .env.
# Variabel NEXT_PUBLIC_* ter-inline ke bundle browser SAAT BUILD — ubah lalu build ulang.

# Backend CKAN yang dipanggil server (build & revalidate).
DMS=https://data.singkawangkota.go.id

# Host publik CKAN untuk URL unduhan/gambar yang sampai ke browser.
CKAN_PUBLIC_URL=https://data.singkawangkota.go.id

# Berita Media Center (diambil dari browser).
NEXT_PUBLIC_MEDIACENTER_URL=https://mediacenter.singkawangkota.go.id
NEXT_PUBLIC_MEDIACENTER_QUERY=statistik

# Halaman Agent Satu Data (https). Kosong = panel tampil "belum dikonfigurasi".
NEXT_PUBLIC_AGENT_URL=

# Opsional
# REVALIDATE_SECONDS=300
# SITE_URL=http://localhost:3000
# CKAN_REWRITE_HOSTS=satudata.singkawangkota.go.id,172.16.20.229:5000,172.16.20.229
