# Salin ke .env (di server, di samping docker-compose.yml) lalu: docker compose up -d --build
# Tidak ada rahasia di sini; tetap jangan commit file .env aslinya.

# CKAN lewat IP internal: server berada di belakang NAT tanpa hairpin, jadi tidak
# bisa menjangkau IP publiknya sendiri. Sesuaikan dengan alamat CKAN Anda.
DMS=http://172.16.20.229:5000

# Host publik yang dipakai browser pengunjung.
CKAN_PUBLIC_URL=https://data.singkawangkota.go.id

# Domain portal ini (untuk katalog DCAT).
SITE_URL=https://satudata.singkawangkota.go.id

# Berita: browser memanggil host ini -> WAJIB ada di CSP nginx
# (connect-src & img-src, lihat deploy/nginx/security-headers.conf).
NEXT_PUBLIC_MEDIACENTER_URL=https://mediacenter.singkawangkota.go.id
NEXT_PUBLIC_MEDIACENTER_QUERY=statistik

# Halaman Agent Satu Data (https). Host-nya WAJIB ada di CSP frame-src.
NEXT_PUBLIC_AGENT_URL=https://AGENT_HOST/

REVALIDATE_SECONDS=300
